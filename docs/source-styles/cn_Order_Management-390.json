      "fontStyle": "normal",
      "lineHeight": "28px",
      "letterSpacing": "normal",
      "textTransform": "none",
      "color": "rgb(51, 51, 51)"
    },
    {
      "text": "轻松了解每笔订单的进度",
      "tag": "STRONG",
      "cls": "",
      "module": "module_720546143",
