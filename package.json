{
  "name": "lbh-appliances",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-routes.mjs --generate-legacy --output out --manifest source-cache/manifest.json",
    "start": "http-server out -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node scripts/capture-source.mjs --origin https://www.lbhappliances.com --cache source-cache",
    "capture:regenerate": "node scripts/build-content.mjs",
    "capture:verify": "node scripts/check-source-manifest.mjs --cache source-cache && node scripts/check-assets.mjs --capture-integrity",
    "assets:manifest": "node scripts/update-shipped-assets.mjs",
    "check:pages": "node scripts/check-page-correspondence.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "http-server": "14.1.1",
    "jsdom": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
